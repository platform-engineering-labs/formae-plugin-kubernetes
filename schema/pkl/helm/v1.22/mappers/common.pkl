/// Shared mapper functions for converting pkl-k8s types to k8s types.
///
/// All mapper functions accept `Any` as the source parameter — a pragmatic trade-off
/// because pkl-k8s module-level types aren't cleanly importable as function parameter types.
/// Runtime errors from field access are clear and actionable.
module common

import "@formae/formae.pkl"
import "../../../v1.22/k8s.pkl" as k8s
import "../../../v1.22/core/Namespace.pkl" as ns

/// A mapper's target namespace. Normally the literal namespace string, but
/// when HelmChart.createNamespace is set it is a formae.Resolvable pointing at
/// the chart-created Namespace resource — that reference is what makes formae
/// order the namespace before the resources placed in it (fixes the
/// "namespaces <x> not found" apply race). NamespacedObjectMeta.namespace
/// already accepts this union, so the value threads straight through.
typealias NamespaceArg = String | formae.Resolvable

// =============================================================================
// Label generation
// =============================================================================

/// Generate a Formae label from prefix, kind, and resource name.
/// Format: <prefix>-<kind-lower>-<name>
function makeLabel(prefix: String, kind: String, name: String): String =
  "\(prefix)-\(kind.toLowerCase())-\(name)"

// =============================================================================
// ObjectMeta mappers
// =============================================================================

/// Map a pkl-k8s ObjectMeta to k8s ObjectMeta (namespaced resource).
function mapObjectMeta(src: Any, defaultNamespace: NamespaceArg): k8s.NamespacedObjectMeta =
  new k8s.NamespacedObjectMeta {
    name = src.name
    // A resolvable defaultNamespace means the caller is creating/controlling
    // the namespace (HelmChart.createNamespace): force every resource into it
    // so the reference becomes formae's ordering edge, overriding any literal
    // `namespace:` helm stamped into the rendered manifest. A plain-string
    // default keeps the prior behaviour: prefer the manifest's own namespace.
    namespace =
      if (defaultNamespace is formae.Resolvable) defaultNamespace
      else if (src.namespace != null) src.namespace
      else defaultNamespace
    when (src.labels != null) {
      labels = mapStringMapping(src.labels)
    }
    when (src.annotations != null) {
      annotations = filterAnnotations(src.annotations)
    }
  }

/// Map a pkl-k8s ObjectMeta to k8s ObjectMeta for cluster-scoped resources (no namespace).
function mapClusterMeta(src: Any): k8s.ObjectMeta =
  new k8s.ObjectMeta {
    name = src.name
    when (src.labels != null) {
      labels = mapStringMapping(src.labels)
    }
    when (src.annotations != null) {
      annotations = filterAnnotations(src.annotations)
    }
  }

/// Map a pkl-k8s ObjectMeta to NamespaceMetadata.
function mapNamespaceMetadata(src: Any): ns.NamespaceMetadata =
  new ns.NamespaceMetadata {
    name = src.name
    when (src.labels != null) {
      labels = mapStringMapping(src.labels)
    }
    when (src.annotations != null) {
      annotations = filterAnnotations(src.annotations)
    }
  }

// =============================================================================
// LabelSelector mappers
// =============================================================================

/// Map a pkl-k8s LabelSelector to k8s LabelSelector.
function mapLabelSelector(src: Any): k8s.LabelSelector =
  new k8s.LabelSelector {
    when (src.matchLabels != null) {
      matchLabels = mapStringMapping(src.matchLabels)
    }
    when (src.matchExpressions != null) {
      matchExpressions = new Listing {
        for (_expr in src.matchExpressions) {
          mapLabelSelectorRequirement(_expr)
        }
      }
    }
  }

/// Map a pkl-k8s LabelSelector to k8s.LabelSelector (shared sub-resource type).
/// Use this for resources that reference k8s.LabelSelector directly (e.g. admissionregistration webhooks).
function mapK8sLabelSelector(src: Any): k8s.LabelSelector =
  new k8s.LabelSelector {
    when (src.matchLabels != null) {
      matchLabels = mapStringMapping(src.matchLabels)
    }
    when (src.matchExpressions != null) {
      matchExpressions = new Listing {
        for (_expr in src.matchExpressions) {
          mapK8sLabelSelectorRequirement(_expr)
        }
      }
    }
  }

/// Map a pkl-k8s LabelSelectorRequirement to k8s.LabelSelectorRequirement.
function mapK8sLabelSelectorRequirement(src: Any): k8s.LabelSelectorRequirement =
  new k8s.LabelSelectorRequirement {
    key = src.key
    operator = src.operator
    when (src.values != null) {
      values = new Listing {
        for (_v in src.values) {
          _v
        }
      }
    }
  }

/// Map a pkl-k8s LabelSelectorRequirement.
function mapLabelSelectorRequirement(src: Any): k8s.LabelSelectorRequirement =
  new k8s.LabelSelectorRequirement {
    key = src.key
    operator = src.operator
    when (src.values != null) {
      values = new Listing {
        for (_v in src.values) {
          _v
        }
      }
    }
  }

// =============================================================================
// Pod-related mappers
// =============================================================================

/// Map a pkl-k8s PodSpec to k8s PodSpec. `prefix` is the chart's label prefix,
/// used to wire serviceAccountName to its ServiceAccount resource.
function mapPodSpec(src: Any, prefix: String): k8s.PodSpec =
  new k8s.PodSpec {
    containers = new Listing {
      for (_c in src.containers) {
        mapContainer(_c)
      }
    }
    // Init containers — Ory charts run DB automigration as an initContainer;
    // dropping them meant migrations never ran.
    when (src.initContainers != null) {
      initContainers = new Listing {
        for (_c in src.initContainers) {
          mapContainer(_c)
        }
      }
    }
    // Pod volumes — config/secret/emptyDir volumes the containers mount.
    when (src.volumes != null) {
      volumes = new Listing {
        for (_v in src.volumes) {
          mapVolume(_v)
        }
      }
    }
    when (src.restartPolicy != null) {
      restartPolicy = src.restartPolicy
    }
    when (src.nodeSelector != null) {
      nodeSelector = mapStringMapping(src.nodeSelector)
    }
    when (src.serviceAccountName != null) {
      serviceAccountName = saRef(src.serviceAccountName, prefix)
    }
    // Pod-level image pull secrets. Dropping these made private-registry charts
    // (Ory, NATS) render pods that pulled anonymously -> 401 ImagePullBackOff
    // even when the chart values set imagePullSecrets correctly.
    when (src.imagePullSecrets != null) {
      imagePullSecrets = new Listing {
        for (_ref in src.imagePullSecrets) {
          new k8s.LocalObjectReference { name = _ref.name }
        }
      }
    }
  }

/// Wire a workload's serviceAccountName to its ServiceAccount resource so
/// formae creates the SA first (and resolves the name). serviceAccountName is
/// resolvable-typed, so this round-trips to the SA name with no drift.
///
/// Charts that name their own SA define it in the same render, so the resolvable
/// resolves cleanly. The built-in "default" SA is never chart-defined — leave it
/// a plain string to avoid a dangling reference.
function saRef(name: String, prefix: String): String|formae.Resolvable =
  if (name == "default") name
  else new formae.Resolvable {
    type = "K8S::Core::ServiceAccount"
    label = makeLabel(prefix, "serviceaccount", name)
    property = "metadata.name"
  }

/// Map a pkl-k8s Container to k8s Container.
function mapContainer(src: Any): k8s.Container =
  new k8s.Container {
    name = src.name
    image = src.image
    when (src.command != null) {
      command = new Listing {
        for (_c in src.command) {
          _c
        }
      }
    }
    when (src.args != null) {
      args = new Listing {
        for (_a in src.args) {
          _a
        }
      }
    }
    when (src.env != null) {
      env = new Listing {
        for (_e in src.env) {
          mapEnvVar(_e)
        }
      }
    }
    when (src.envFrom != null) {
      envFrom = new Listing {
        for (_ef in src.envFrom) {
          mapEnvFromSource(_ef)
        }
      }
    }
    when (src.ports != null) {
      ports = new Listing {
        for (_p in src.ports) {
          mapContainerPort(_p)
        }
      }
    }
    when (src.resources != null) {
      resources = mapResourceRequirements(src.resources)
    }
    // Volume mounts — dropping these left config-file volumes unmounted, so
    // charts that read config from a mounted ConfigMap (Ory, NATS) crashed
    // "no such file or directory".
    when (src.volumeMounts != null) {
      volumeMounts = new Listing {
        for (_m in src.volumeMounts) {
          mapVolumeMount(_m)
        }
      }
    }
  }

/// Map a VolumeMount.
function mapVolumeMount(src: Any): k8s.VolumeMount =
  new k8s.VolumeMount {
    name = src.name
    mountPath = src.mountPath
    when (src.subPath != null) { subPath = src.subPath }
    when (src.readOnly != null) { readOnly = src.readOnly }
  }

/// Map a pod Volume. Covers the source types charts use in practice
/// (configMap, secret, emptyDir, persistentVolumeClaim). Exotic sources are
/// intentionally not mapped yet — add them here when a chart needs one.
function mapVolume(src: Any): k8s.Volume =
  new k8s.Volume {
    name = src.name
    when (src.configMap != null) {
      configMap = new k8s.ConfigMapVolumeSource {
        when (src.configMap.name != null) { name = src.configMap.name }
        when (src.configMap.defaultMode != null) { defaultMode = src.configMap.defaultMode }
        when (src.configMap.optional != null) { optional = src.configMap.optional }
        when (src.configMap.items != null) {
          items = new Listing { for (_i in src.configMap.items) { mapKeyToPath(_i) } }
        }
      }
    }
    when (src.secret != null) {
      secret = new k8s.SecretVolumeSource {
        when (src.secret.secretName != null) { secretName = src.secret.secretName }
        when (src.secret.defaultMode != null) { defaultMode = src.secret.defaultMode }
        when (src.secret.optional != null) { optional = src.secret.optional }
        when (src.secret.items != null) {
          items = new Listing { for (_i in src.secret.items) { mapKeyToPath(_i) } }
        }
      }
    }
    when (src.emptyDir != null) {
      emptyDir = new k8s.EmptyDirVolumeSource {
        when (src.emptyDir.medium != null) { medium = src.emptyDir.medium }
        when (src.emptyDir.sizeLimit != null) { sizeLimit = src.emptyDir.sizeLimit }
      }
    }
    when (src.persistentVolumeClaim != null) {
      persistentVolumeClaim = new k8s.PersistentVolumeClaimVolumeSource {
        claimName = src.persistentVolumeClaim.claimName
        when (src.persistentVolumeClaim.readOnly != null) { readOnly = src.persistentVolumeClaim.readOnly }
      }
    }
  }

/// Map a KeyToPath (configMap/secret volume item projection).
function mapKeyToPath(src: Any): k8s.KeyToPath =
  new k8s.KeyToPath {
    key = src.key
    path = src.path
    when (src.mode != null) { mode = src.mode }
  }

/// Map an environment variable, including valueFrom sources. Dropping
/// valueFrom left secret/configmap/field-sourced env empty — e.g. Ory's DB
/// `dsn` (secretKeyRef) and ingress-nginx's `POD_NAMESPACE` (fieldRef) — which
/// crashed those pods ("dsn must be set", "namespace : not found").
function mapEnvVar(src: Any): k8s.EnvVar =
  new k8s.EnvVar {
    name = src.name
    when (src.value != null) {
      value = src.value
    }
    when (src.valueFrom != null) {
      valueFrom = new k8s.EnvVarSource {
        when (src.valueFrom.secretKeyRef != null) {
          secretKeyRef = new k8s.SecretKeySelector {
            when (src.valueFrom.secretKeyRef.name != null) { name = src.valueFrom.secretKeyRef.name }
            key = src.valueFrom.secretKeyRef.key
            when (src.valueFrom.secretKeyRef.optional != null) { optional = src.valueFrom.secretKeyRef.optional }
          }
        }
        when (src.valueFrom.configMapKeyRef != null) {
          configMapKeyRef = new k8s.ConfigMapKeySelector {
            when (src.valueFrom.configMapKeyRef.name != null) { name = src.valueFrom.configMapKeyRef.name }
            key = src.valueFrom.configMapKeyRef.key
            when (src.valueFrom.configMapKeyRef.optional != null) { optional = src.valueFrom.configMapKeyRef.optional }
          }
        }
        when (src.valueFrom.fieldRef != null) {
          fieldRef = new k8s.ObjectFieldSelector {
            fieldPath = src.valueFrom.fieldRef.fieldPath
            when (src.valueFrom.fieldRef.apiVersion != null) { apiVersion = src.valueFrom.fieldRef.apiVersion }
          }
        }
      }
    }
  }

/// Map an EnvFromSource (whole-ConfigMap/Secret env injection).
function mapEnvFromSource(src: Any): k8s.EnvFromSource =
  new k8s.EnvFromSource {
    when (src.prefix != null) { prefix = src.prefix }
    when (src.configMapRef != null) {
      configMapRef = new k8s.ConfigMapEnvSource {
        when (src.configMapRef.name != null) { name = src.configMapRef.name }
        when (src.configMapRef.optional != null) { optional = src.configMapRef.optional }
      }
    }
    when (src.secretRef != null) {
      secretRef = new k8s.SecretEnvSource {
        when (src.secretRef.name != null) { name = src.secretRef.name }
        when (src.secretRef.optional != null) { optional = src.secretRef.optional }
      }
    }
  }

/// Map a container port.
function mapContainerPort(src: Any): k8s.ContainerPort =
  new k8s.ContainerPort {
    containerPort = src.containerPort
    when (src.protocol != null) {
      protocol = src.protocol
    }
    when (src.name != null) {
      name = src.name
    }
  }

/// Map resource requirements.
function mapResourceRequirements(src: Any): k8s.ResourceRequirements =
  new k8s.ResourceRequirements {
    when (src.limits != null) {
      limits = mapQuantityMapping(src.limits)
    }
    when (src.requests != null) {
      requests = mapQuantityMapping(src.requests)
    }
  }

// =============================================================================
// PodTemplate mappers
// =============================================================================

/// Map a PodTemplateSpec.
///
/// PodTemplateSpec.metadata is k8s.ObjectMeta? — ObjectMeta requires
/// name. Pod templates conventionally inherit name from their owner
/// (Deployment/StatefulSet/etc), so leave metadata unset rather than
/// invent a name. Labels + annotations from the source are dropped
/// here; if a chart sets them on the template, the owning workload
/// surfaces them via its own selector.
function mapPodTemplateSpec(src: Any, ownerName: String, prefix: String): k8s.PodTemplateSpec =
  new k8s.PodTemplateSpec {
    when (src.metadata != null && (src.metadata.labels != null || src.metadata.annotations != null)) {
      metadata = mapPodTemplateMetadata(src.metadata, ownerName)
    }
    spec = mapPodSpec(src.spec, prefix)
  }

/// Map PodTemplate metadata (labels + annotations only).
///
/// PodTemplateSpec.metadata is typed `k8s.PodTemplateMetadata?` in the
/// versioned schemas (labels + annotations only, no name — pod templates
/// inherit name from their owner). Returning ObjectMeta here failed
/// PodTemplateSpec's type check on every chart whose pod template carries
/// labels or annotations, i.e. virtually all charts.
function mapPodTemplateMetadata(src: Any, ownerName: String): k8s.PodTemplateMetadata =
  new k8s.PodTemplateMetadata {
    when (src.labels != null) {
      labels = mapStringMapping(src.labels)
    }
    when (src.annotations != null) {
      annotations = filterAnnotations(src.annotations)
    }
  }

// =============================================================================
// Utility functions
// =============================================================================

/// Convert a Dynamic/Mapping of string keys to a Mapping<String, String>.
/// Handles both standard mappings and Dynamic objects from pkl-k8s.
function mapStringMapping(src: Any): Mapping<String, String> =
  new Mapping {
    for (k, v in src) {
      [k] = v
    }
  }

/// Convert a Quantity mapping to Mapping<String, String>.
/// pkl-k8s Quantity types render as strings.
function mapQuantityMapping(src: Any): Mapping<String, String> =
  new Mapping {
    for (k, v in src) {
      [k] = "\(v)"
    }
  }

/// Filter out annotations that are empty or null, converting to Mapping<String, String>.
function filterAnnotations(src: Any): Mapping<String, String> =
  new Mapping {
    for (k, v in src) {
      when (v != null && "\(v)" != "") {
        [k] = "\(v)"
      }
    }
  }

/// Convert a Listing of strings from pkl-k8s Dynamic to formae Listing<String>.
function mapStringListing(src: Any): Listing<String> =
  new Listing {
    for (_s in src) {
      "\(_s)"
    }
  }
