 * SPDX-License-Identifier: Apache-2.0
 *
 * K8S Plugin Schema - Target configuration.
 *
 * Holds ONLY the cluster connection / authentication configuration:
 *   - Config (top-level target config)
 *   - Auth (abstract base) + KubeconfigAuth / EKSAuth / GKEAuth / AKSAuth / OVHAuth / OCIAuth
 *
 * Resource scaffolding (Resource, ObjectMeta, …), typealiases, and the K8sVersion
 * annotation live in shared.pkl. Shared sub-resource classes (PodSpec, Container,
 * Volume, JobSpec, …) live in k8s-subresources.pkl and are filtered per K8s minor
 * by tools/gen-versioned-reflect at generation time.
 *
 * Consumers of this file (root, version-agnostic):
 *   - formae-plugin.pkl (package manifest)
 *   - Go-side target config marshaling (pkg/config/config.go)
 *   - Conformance test bootstrap
 */
// Extends shared.pkl so this slim root inherits every typealias,
// helper, the K8sVersion annotation, Resource base, and the ObjectMeta
// variants. The per-version source `k8s-subresources.pkl` in turn
// extends THIS module, so the per-version generated `v<X.Y>/k8s.pkl`
// reaches Config + Auth + every type + every SubResource class through
// a single `k8s.` alias at consumer sites.
open module target extends "shared.pkl"

import "@formae/formae.pkl"

// =============================================================================
// Target Configuration
// =============================================================================

/// Configuration for the K8S target.
/// Maps to the Go Config struct in pkg/config/config.go.
open class Config {
  hidden fixed type: String = "K8S"

  /// Authentication strategy. Determines how the plugin connects to the
  /// K8S API server.
  @formae.ConfigFieldHint { createOnly = true }
  hidden auth: Auth

  /// Kubernetes minor version of the target cluster, e.g. "1.27".
  /// Required so formae picks the right schema subtree at extract
  /// time. Users set this; the convention key `ApiVersion` is derived
  /// and emitted to the marshaled Config JSON, where formae's
  /// schema-version resolver reads it.
  @formae.ConfigFieldHint { createOnly = false }
  hidden kubernetesVersion: KubernetesMinorVersion

  fixed Type: String = type
  fixed Auth: Auth = auth

  /// Convention key. Formae's schema-version resolver scans
  /// target.Config JSON for `ApiVersion`; the K8s plugin derives it
  /// from `kubernetesVersion` so users never type the `v` prefix.
  fixed ApiVersion: String = "v\(kubernetesVersion)"
}

// =============================================================================
// Auth Strategies
// =============================================================================

/// Base class for K8S authentication strategies.
abstract class Auth {
  /// Discriminator field for Go-side deserialization.
  hidden fixed type: String
  fixed Type: String = type
}

/// AWS credentials accepted by EKS auth.
abstract class AwsCredentials {
  hidden fixed type: String
  fixed Type: String = type
}

/// Broker-backed AWS role federation credentials.
class AwsOidcCredentials extends AwsCredentials {
  fixed type = "Oidc"
  hidden roleArn: (String|formae.Resolvable)
  fixed RoleArn: (String|formae.Resolvable) = roleArn
}

/// Azure credentials accepted by AKS auth.
abstract class AzureCredentials {
  hidden fixed type: String
  fixed Type: String = type
}

/// Broker-backed Entra workload federation credentials.
class AzureOidcCredentials extends AzureCredentials {
  fixed type = "Oidc"
  hidden tenantId: (String|formae.Resolvable)
  hidden clientId: (String|formae.Resolvable)
  fixed TenantId: (String|formae.Resolvable) = tenantId
  fixed ClientId: (String|formae.Resolvable) = clientId
}

/// Google credentials accepted by GKE auth.
abstract class GcpCredentials {
  hidden fixed type: String
  fixed Type: String = type
}

/// Broker-backed Google workload federation credentials.
class GcpOidcCredentials extends GcpCredentials {
  fixed type = "Oidc"
  hidden workloadIdentityProvider: (String|formae.Resolvable)
  hidden serviceAccountEmail: (String|formae.Resolvable)?
  fixed WorkloadIdentityProvider: (String|formae.Resolvable) = workloadIdentityProvider
  fixed ServiceAccountEmail: (String|formae.Resolvable)? = serviceAccountEmail
}

/// Kubeconfig-based auth. Covers vanilla K8S, dev clusters, and any
/// pre-configured cluster.
class KubeconfigAuth extends Auth {
  fixed type = "Kubeconfig"
  hidden context: String?
  hidden kubeconfig: String?
  fixed Context: String? = context
  fixed Kubeconfig: String? = kubeconfig
}

/// AWS EKS auth via STS presigned token.
class EKSAuth extends Auth {
  fixed type = "EKS"
  hidden endpoint: (String|formae.Resolvable)
  hidden certificateAuthority: (String|formae.Resolvable)
  hidden clusterName: (String|formae.Resolvable)
  hidden region: (String|formae.Resolvable)?
  hidden credentials: AwsCredentials?
  fixed Endpoint: (String|formae.Resolvable) = endpoint
  fixed CertificateAuthority: (String|formae.Resolvable) = certificateAuthority
  fixed ClusterName: (String|formae.Resolvable) = clusterName
  fixed Region: (String|formae.Resolvable)? = region
  fixed Credentials: AwsCredentials? = credentials
}

/// Google GKE auth via OAuth2 access token.
/// ProjectId, Location and ClusterName are optional but recommended:
/// together they identify a cluster within Google Cloud, and the plugin
/// keys its token cache on them. Omit all three and two targets are told
/// apart by their endpoint alone.
class GKEAuth extends Auth {
  fixed type = "GKE"
  hidden endpoint: (String|formae.Resolvable)
  hidden certificateAuthority: (String|formae.Resolvable)
  hidden projectId: (String|formae.Resolvable)?
  hidden location: (String|formae.Resolvable)?
  hidden clusterName: (String|formae.Resolvable)?
  hidden credentials: GcpCredentials?
  fixed Endpoint: (String|formae.Resolvable) = endpoint
  fixed CertificateAuthority: (String|formae.Resolvable) = certificateAuthority
  fixed ProjectId: (String|formae.Resolvable)? = projectId
  fixed Location: (String|formae.Resolvable)? = location
  fixed ClusterName: (String|formae.Resolvable)? = clusterName
  fixed Credentials: GcpCredentials? = credentials
}

/// Azure AKS auth via Azure AD token.
///
/// Alone among the cloud auth types, AKS can look its own connection details
/// up, so `endpoint` and `certificateAuthority` are optional here. Name the
/// resource group and cluster and the plugin reads both from Azure.
///
/// This exists because Azure does not put the CA on the ManagedCluster
/// resource at all. It is only reachable through the credentials endpoints,
/// which the azure plugin calls during Read and which silently yields nothing
/// when denied or when the cluster sets `disableLocalAccounts` — leaving a
/// discovered cluster with an empty CA and no indication why. Reading it at
/// connect time turns that into a real error. User credentials are tried
/// first (AAD-based, needs only `listClusterUserCredential/action`, survives
/// `disableLocalAccounts`), admin as a fallback; only the server URL and CA
/// are taken from the returned kubeconfig, and the token still comes from the
/// agent's own Azure identity.
///
/// Stating both fields still works and always wins, which is the path for a
/// private endpoint or anything formae does not model.
///
/// `subscriptionId` falls back to the agent's `AZURE_SUBSCRIPTION_ID`; a
/// hosted agent can span subscriptions, so the lookup cannot assume one.
class AKSAuth extends Auth {
  fixed type = "AKS"
  hidden subscriptionId: (String|formae.Resolvable)?
  hidden resourceGroup: (String|formae.Resolvable)?
  hidden clusterName: (String|formae.Resolvable)?
  hidden endpoint: (String|formae.Resolvable)?
  hidden certificateAuthority: (String|formae.Resolvable)?
  hidden credentials: AzureCredentials?
  fixed SubscriptionId: (String|formae.Resolvable)? = subscriptionId
  fixed ResourceGroup: (String|formae.Resolvable)? = resourceGroup
  fixed ClusterName: (String|formae.Resolvable)? = clusterName
  fixed Endpoint: (String|formae.Resolvable)? =
    if (credentials != null && endpoint == null)
      throw("AKS endpoint is required when credentials are present")
    else endpoint
  fixed CertificateAuthority: (String|formae.Resolvable)? =
    if (credentials != null && certificateAuthority == null)
      throw("AKS certificateAuthority is required when credentials are present")
    else certificateAuthority
  fixed Credentials: AzureCredentials? = credentials
}

/// Direct broker-issued Kubernetes OIDC authentication.
class OidcAuth extends Auth {
  fixed type = "Oidc"
  hidden endpoint: (String|formae.Resolvable)
  hidden certificateAuthority: (String|formae.Resolvable)
  hidden audience: (String|formae.Resolvable)
  fixed Endpoint: (String|formae.Resolvable) = endpoint
  fixed CertificateAuthority: (String|formae.Resolvable) = certificateAuthority
  fixed Audience: (String|formae.Resolvable) = audience
}

/// OVH Managed K8S auth.
class OVHAuth extends Auth {
  fixed type = "OVH"
  hidden endpoint: (String|formae.Resolvable)
  hidden certificateAuthority: (String|formae.Resolvable)
  hidden serviceName: (String|formae.Resolvable)
  hidden clusterId: (String|formae.Resolvable)
  fixed Endpoint: (String|formae.Resolvable) = endpoint
  fixed CertificateAuthority: (String|formae.Resolvable) = certificateAuthority
  fixed ServiceName: (String|formae.Resolvable) = serviceName
  fixed ClusterId: (String|formae.Resolvable) = clusterId
}

/// Oracle OKE auth via OCI session token.
class OCIAuth extends Auth {
  fixed type = "OCI"
  hidden endpoint: (String|formae.Resolvable)
  hidden certificateAuthority: (String|formae.Resolvable)
  hidden clusterOcid: (String|formae.Resolvable)
  hidden region: (String|formae.Resolvable)?
  fixed Endpoint: (String|formae.Resolvable) = endpoint
  fixed CertificateAuthority: (String|formae.Resolvable) = certificateAuthority
  fixed ClusterOcid: (String|formae.Resolvable) = clusterOcid
  fixed Region: (String|formae.Resolvable)? = region
}
