/// TDD test for HelmChart.createNamespace.
///
/// Behaviour under test: when `createNamespace = true`, HelmChart emits a
/// Namespace resource named after `namespace`, and the chart's namespaced
/// resources reference it (so formae orders the namespace first — fixes the
/// "namespaces <x> not found" race seen deploying ingress-nginx).
///
/// Run (from repo root):
///   pkl project resolve examples/
///   pkl eval --project-dir examples -x namespaceCount examples/helm/create-namespace-test.pkl  # want 1
///   pkl eval --project-dir examples -x namespaceName  examples/helm/create-namespace-test.pkl  # want cnt-test-ns
///   pkl eval --project-dir examples -x withoutFlagCount examples/helm/create-namespace-test.pkl # want 0
///
/// PASS = namespaceCount 1, namespaceName "cnt-test-ns", withoutFlagCount 0.
/// FAIL (pre-fix) = eval errors: `createNamespace` is not a HelmChart property.
module create_namespace_test

import "@k8s/helm/v1.31/HelmChart.pkl"

local baseValues = new Dynamic {
  replicaCount = 1
  service { type = "ClusterIP" }
  networkPolicy { enabled = false }
  podDisruptionBudget { create = false }
  tls { enabled = false }
  automountServiceAccountToken = true
}

local chart = new HelmChart {
  chart = "bitnami/nginx"
  version = "22.4.7"
  releaseName = "cnt"
  namespace = "cnt-test-ns"
  createNamespace = true
  values = baseValues
}

// Default (createNamespace = false) must NOT emit a Namespace — proves the
// flag gates the new behaviour and doesn't change the old default.
local chartNoFlag = new HelmChart {
  chart = "bitnami/nginx"
  version = "22.4.7"
  releaseName = "cnt2"
  namespace = "cnt-test-ns"
  values = baseValues
}

local function namespaces(c: HelmChart) =
  c.resources.toList().filter((r) -> r.getClass().simpleName == "Namespace")

// Namespaced (non-Namespace) resources that carry a metadata.namespace.
local namespaced = chart.resources.toList().filter((r) ->
  r.getClass().simpleName != "Namespace"
    && r.hasProperty("metadata")
    && r.metadata.hasProperty("namespace")
    && r.metadata.namespace != null)

namespaceCount: Int = namespaces(chart).length
namespaceName: String? = if (namespaces(chart).isEmpty) null else namespaces(chart).first.metadata.name
withoutFlagCount: Int = namespaces(chartNoFlag).length
// The ordering edge: a namespaced resource's namespace must be a formae
// reference (Resolvable), not a literal string — even though helm stamps a
// literal `namespace:` into the rendered manifest.
namespaceIsResolvable: Boolean = !namespaced.isEmpty && !(namespaced.first.metadata.namespace is String)
