/// TDD test: HelmChart must carry pod-level imagePullSecrets from the rendered
/// chart into the mapped workload's PodSpec. Regression: private-registry
/// charts (Ory kratos/keto/oathkeeper, NATS) rendered pods with NO
/// imagePullSecrets -> anonymous pull -> 401 ImagePullBackOff, even though the
/// chart values set imagePullSecrets correctly.
///
/// Run:
///   helm repo add ory https://k8s.ory.sh/helm/charts && helm repo update
///   pkl eval --project-dir examples -x deploymentPullSecretName \
///     examples/helm/imagepullsecrets-test.pkl        # want "accesscr"
///
/// PASS = "accesscr". FAIL (pre-fix) = null (mapPodSpec dropped the field).
module imagepullsecrets_test

import "@k8s/helm/v1.31/HelmChart.pkl"

local chart = new HelmChart {
  chart = "ory/kratos"
  version = "0.50.0"
  releaseName = "kr"
  namespace = "dqc-pe"
  values = new Dynamic {
    imagePullSecrets = new Listing { new Dynamic { name = "accesscr" } }
  }
}

local dep = chart.resources.toList().filter((r) -> r.getClass().simpleName == "Deployment").first
local ips = dep.spec.template.spec.imagePullSecrets

deploymentPullSecretName: String? =
  if (ips == null || ips.toList().isEmpty) null else ips.toList().first.name
