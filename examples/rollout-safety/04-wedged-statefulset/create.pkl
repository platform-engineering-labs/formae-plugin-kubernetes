/// Case 04 — wedged StatefulSet. CREATE: healthy nginx:1.27.
///
///   formae apply examples/rollout-safety/04-wedged-statefulset/create.pkl
amends "@formae/forma.pkl"

import "@formae/formae.pkl"
import "@clusters/local.pkl" as cluster
import "@k8s/v1.34/apps/StatefulSet.pkl" as sts
import "@k8s/v1.34/k8s.pkl" as k8s

local k8sTarget = cluster.target("rollout-wedged")

forma {
  new formae.Stack { label = "rollout-wedged"; description = "Rollout-safety case 04: wedged StatefulSet" }
  k8sTarget
  new sts.StatefulSet {
    target = k8sTarget.res
    label = "wedged-demo"
    metadata = new k8s.NamespacedObjectMeta {
      name = "wedged-demo"
      namespace = "default"
    }
    spec = new sts.StatefulSetSpec {
      serviceName = "wedged-demo"
      replicas = 1
      selector = new k8s.LabelSelector {
        matchLabels = new Mapping { ["app"] = "wedged-demo" }
      }
      template = new k8s.PodTemplateSpec {
        metadata = new k8s.PodTemplateMetadata {
          labels = new Mapping { ["app"] = "wedged-demo" }
        }
        spec = new k8s.PodSpec {
          containers {
            new k8s.Container { name = "c"; image = "nginx:1.27" }
          }
        }
      }
    }
  }
}
