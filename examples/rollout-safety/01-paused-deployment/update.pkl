/// Case 01 — paused Deployment. UPDATE: pause + bump image to nginx:1.28.
///
///   formae apply examples/rollout-safety/01-paused-deployment/update.pkl
///
/// The controller observes the paused spec but never rolls the new image
/// (updatedReplicas stays 0). OLD plugin: reports InProgress forever.
/// NEW plugin: reports Success — paused is the declared desired state.
amends "@formae/forma.pkl"

import "@formae/formae.pkl"
import "@clusters/local.pkl" as cluster
import "@k8s/v1.34/apps/Deployment.pkl" as dep
import "@k8s/v1.34/k8s.pkl" as k8s

local k8sTarget = cluster.target("rollout-paused")

forma {
  new formae.Stack { label = "rollout-paused"; description = "Rollout-safety case 01: paused Deployment" }
  k8sTarget
  new dep.Deployment {
    target = k8sTarget.res
    label = "paused-demo"
    metadata = new k8s.NamespacedObjectMeta {
      name = "paused-demo"
      namespace = "default"
    }
    spec = new dep.DeploymentSpec {
      replicas = 3
      paused = true
      selector = new k8s.LabelSelector {
        matchLabels = new Mapping { ["app"] = "paused-demo" }
      }
      template = new k8s.PodTemplateSpec {
        metadata = new k8s.PodTemplateMetadata {
          labels = new Mapping { ["app"] = "paused-demo" }
        }
        spec = new k8s.PodSpec {
          containers {
            new k8s.Container { name = "nginx"; image = "nginx:1.28" }
          }
        }
      }
    }
  }
}
