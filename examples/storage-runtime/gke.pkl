amends "@formae/forma.pkl"

import "@formae/formae.pkl"
import "./workload.pkl" as workload

description {
  text = """
    Storage workload on GKE with Sandbox (gVisor) nodes.

      formae apply --mode reconcile examples/s3-mountpoint-gvisor/gke.pkl

    Runs the Pod sandboxed under gVisor. Requires a GKE node pool with Sandbox
    enabled; GKE labels those nodes sandbox.gke.io/runtime=gvisor, which the
    RuntimeClass scheduling + Pod nodeSelector target. Storage is a PVC on GKE's
    dynamic "standard-rwo" StorageClass.

    Verify:
      kubectl exec app -- cat /data/demo.txt

    Teardown:
      formae destroy --yes examples/s3-mountpoint-gvisor/gke.pkl
    """
  confirm = true
}

local cfg = new workload.Config {
  k8sVersion = "1.34"
  storageBackend = "dynamic"
  storageClass = "standard-rwo"
  runtimeHandler = "runsc"
  runtimeNodeSelector = new { ["sandbox.gke.io/runtime"] = "gvisor" }
}

local stack: formae.Stack = new {
  label = "storage-runtime-gke"
  description = "Storage workload on GKE Sandbox (gVisor)."
}

forma {
  stack
  ...workload.targets(cfg)
  ...workload.resources(cfg)
}
