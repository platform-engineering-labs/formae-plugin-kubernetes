// Reusable storage-plus-sandbox workload module.
//
// Deploys a Pod that mounts some storage at /data and writes a file, plus the
// resources that back it. Parameterized by a `Config` so each environment file
// (local.pkl, minikube.pkl, gke.pkl, eks.pkl) just fills in the knobs and
// spreads the result:
//
//   import "./workload.pkl" as workload
//   local cfg = new workload.Config { ... }
//   forma {
//     stack
//     ...workload.targets(cfg)
//     ...workload.resources(cfg)
//   }
//
// Two orthogonal axes:
//   storage  -> "dynamic" (PVC against a StorageClass) | "s3" (bucket + Mountpoint
//               CSI + static PV, PVC pins it)
//   runtime  -> cluster default | a sandbox RuntimeClass (e.g. gVisor "runsc")
module workload

import "@formae/formae.pkl"

import "@aws/aws.pkl"
import "@aws/s3/bucket.pkl"

import "@k8s/v1.34/k8s.pkl" as k8s
import "@k8s/v1.34/storage/CSIDriver.pkl" as csidriver
import "@k8s/v1.34/core/PersistentVolume.pkl" as pv
import "@k8s/v1.34/core/PersistentVolumeClaim.pkl" as pvc
import "@k8s/v1.34/node/RuntimeClass.pkl" as rc
import "@k8s/v1.34/core/Pod.pkl" as pod

/// One environment's knobs.
class Config {
  /// K8s minor for the formae target (schema imports stay pinned at v1.34; this
  /// only sets the target's kubernetesVersion).
  k8sVersion: String = "1.34"

  /// Storage backend.
  ///   "dynamic" -> a PVC against `storageClass` (cluster provisions the PV)
  ///   "s3"      -> an S3 bucket + Mountpoint CSIDriver + static PV, PVC pins it
  storageBackend: "dynamic" | "s3" = "dynamic"

  /// StorageClass name for the "dynamic" backend. Ignored when backend is "s3".
  storageClass: String = "standard"

  /// Container runtime handler. null = cluster default runtime (no RuntimeClass).
  /// A value (e.g. "runsc") creates a RuntimeClass and sets the Pod's
  /// runtimeClassName. The node's containerd must register this handler.
  runtimeHandler: String?

  /// Optional node selector so sandboxed Pods land on capable nodes.
  runtimeNodeSelector: Mapping<String, String>?

  /// AWS region (only used by the "s3" backend).
  awsRegion: String = "us-east-1"

  /// S3 bucket name (only used by the "s3" backend).
  bucketName: String = "formae-example-s3-gvisor-demo"
}

// Stable resource names, referenced across resources.
local pvName = "app-pv"
local pvcName = "app-pvc"
local rcName = "app-sandbox"

/// Targets this workload needs: always K8s, plus AWS for the "s3" backend.
function targets(cfg: Config): Listing<formae.Target> = new {
  new formae.Target {
    label = "k8s-target"
    config = new k8s.Config {
      kubernetesVersion = cfg.k8sVersion
      auth = new k8s.KubeconfigAuth {}
    }
  }
  when (cfg.storageBackend == "s3") {
    new formae.Target {
      label = "aws-target"
      config = new aws.Config { region = cfg.awsRegion }
    }
  }
}

/// All resources for the workload, emitted conditionally from the config.
function resources(cfg: Config): Listing = new {
  // --- storage: S3 backend (bucket + CSIDriver + static PV) ---
  when (cfg.storageBackend == "s3") {
    new bucket.Bucket {
      label = "demo-bucket"
      bucketName = cfg.bucketName
    }
    // Normally installed by the aws-mountpoint-s3-csi-driver add-on; shown for
    // completeness. Delete if the add-on already owns it.
    new csidriver.CSIDriver {
      label = "s3-csi-driver"
      metadata = new k8s.ObjectMeta { name = "s3.csi.aws.com" }
      spec = new csidriver.CSIDriverSpec {
        attachRequired = false
        podInfoOnMount = false
      }
    }
    new pv.PersistentVolume {
      label = "app-pv"
      metadata = new k8s.ObjectMeta { name = pvName }
      spec = new Mapping {
        ["capacity"] = new Mapping { ["storage"] = "1200Gi" } // ignored by S3
        ["accessModes"] = new Listing { "ReadWriteMany" }
        ["mountOptions"] = new Listing { "allow-delete"; "region \(cfg.awsRegion)" }
        ["csi"] = new Mapping {
          ["driver"] = "s3.csi.aws.com"
          ["volumeHandle"] = "s3-csi-demo-volume"
          ["volumeAttributes"] = new Mapping { ["bucketName"] = cfg.bucketName }
        }
      }
    }
  }

  // --- the PVC: pins the static S3 PV, or requests a dynamic volume ---
  new pvc.PersistentVolumeClaim {
    label = "app-pvc"
    metadata = new k8s.NamespacedObjectMeta {
      name = pvcName
      namespace = "default"
    }
    spec = new pvc.PersistentVolumeClaimSpec {
      local isS3 = cfg.storageBackend == "s3"
      accessModes = new Listing { if (isS3) "ReadWriteMany" else "ReadWriteOnce" }
      storageClassName = if (isS3) "" else cfg.storageClass
      volumeName = if (isS3) pvName else null
      resources = new k8s.ResourceRequirements {
        requests = new Mapping {
          ["storage"] = if (isS3) 1200.gib else 100.mib
        }
      }
    }
  }

  // --- runtime: a sandbox RuntimeClass, only when asked ---
  when (cfg.runtimeHandler != null) {
    new rc.RuntimeClass {
      label = "app-sandbox"
      metadata = new k8s.ObjectMeta { name = rcName }
      handler = cfg.runtimeHandler!!
      scheduling =
        if (cfg.runtimeNodeSelector != null)
          new rc.Scheduling { nodeSelector = cfg.runtimeNodeSelector }
        else null
    }
  }

  // --- the workload: mounts the storage, writes a file ---
  new pod.Pod {
    label = "app"
    metadata = new k8s.NamespacedObjectMeta {
      name = "app"
      namespace = "default"
    }
    spec = new k8s.PodSpec {
      restartPolicy = "Never"
      runtimeClassName = if (cfg.runtimeHandler != null) rcName else null
      nodeSelector = cfg.runtimeNodeSelector
      volumes = new Listing {
        new k8s.Volume {
          name = "data"
          persistentVolumeClaim = new k8s.PersistentVolumeClaimVolumeSource {
            claimName = pvcName
          }
        }
      }
      containers = new Listing {
        new k8s.Container {
          name = "writer"
          image = "public.ecr.aws/docker/library/busybox:1.36"
          command = new Listing {
            "sh"
            "-c"
            "echo \"hello from formae at $(date)\" > /data/demo.txt && cat /data/demo.txt && sleep 3600"
          }
          volumeMounts = new Listing {
            new k8s.VolumeMount { name = "data"; mountPath = "/data" }
          }
        }
      }
    }
  }
}
