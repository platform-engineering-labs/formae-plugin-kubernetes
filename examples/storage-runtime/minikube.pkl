amends "@formae/forma.pkl"

import "@formae/formae.pkl"
import "./workload.pkl" as workload

description {
  text = """
    Storage workload on minikube with the gVisor addon (local sandbox).

      minikube start --container-runtime=containerd
      minikube addons enable gvisor
      formae apply --mode reconcile examples/s3-mountpoint-gvisor/minikube.pkl

    The gvisor addon registers the "runsc" handler on the node, so the Pod runs
    sandboxed under a RuntimeClass. Storage is a PVC on minikube's default
    "standard" StorageClass. (Check the addon supports your k8s version.)

    Verify:
      kubectl exec app -- cat /data/demo.txt

    Teardown:
      formae destroy --yes examples/s3-mountpoint-gvisor/minikube.pkl
    """
  confirm = true
}

local cfg = new workload.Config {
  k8sVersion = "1.34"
  storageBackend = "dynamic"
  storageClass = "standard"
  runtimeHandler = "runsc" // provided by the minikube gvisor addon
}

local stack: formae.Stack = new {
  label = "storage-runtime-minikube"
  description = "Storage workload on minikube with gVisor sandbox."
}

forma {
  stack
  ...workload.targets(cfg)
  ...workload.resources(cfg)
}
