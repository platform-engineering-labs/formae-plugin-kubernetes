/*
 * Platform profiles for the S3 / CSI / RuntimeClass example.
 *
 * A profile bundles the two things that vary between clusters:
 *   - how storage is provided  (dynamic StorageClass vs static S3-backed PV)
 *   - which container runtime the Pod uses (default vs a sandbox like gVisor)
 *
 * Select one at apply time with the PROFILE env var:
 *   PROFILE=orbstack        formae apply --mode reconcile forma.pkl
 *   PROFILE=minikube-gvisor formae apply --mode reconcile forma.pkl
 * Defaults to "orbstack" when PROFILE is unset.
 */
module platform

/// One deployment target's knobs.
class Profile {
  /// K8s minor for the formae target (schema imports stay pinned; this only
  /// sets the target's kubernetesVersion).
  k8sVersion: String

  /// Storage backend.
  ///   "dynamic" -> a PVC against `storageClass` (cluster provisions the PV)
  ///   "s3"      -> an S3 bucket + Mountpoint CSIDriver + static PV, PVC pins it
  storageBackend: "dynamic" | "s3"

  /// StorageClass name for the "dynamic" backend. Ignored when backend is "s3".
  storageClass: String = "standard"

  /// Container runtime handler. null = cluster default runtime (no RuntimeClass).
  /// A value (e.g. "runsc") creates a RuntimeClass and sets the Pod's
  /// runtimeClassName. The node's containerd must register this handler.
  runtimeHandler: String?

  /// Optional node selector so sandboxed Pods land on capable nodes.
  runtimeNodeSelector: Mapping<String, String>?

  /// AWS region (only used by the "s3" backend).
  awsRegion: String = "us-east-1"
}

/// Preset profiles. Add your own cluster here.
profiles: Mapping<String, Profile> = new {
  // Local single-node OrbStack/k3s: built-in local-path SC, no sandbox runtime.
  ["orbstack"] = new {
    k8sVersion = "1.33"
    storageBackend = "dynamic"
    storageClass = "local-path"
    runtimeHandler = null
  }
  // minikube with the gVisor addon (`minikube addons enable gvisor`): the addon
  // registers the "runsc" handler + a gvisor RuntimeClass on the single node.
  ["minikube-gvisor"] = new {
    k8sVersion = "1.34"
    storageBackend = "dynamic"
    storageClass = "standard"
    runtimeHandler = "runsc"
  }
  // GKE Sandbox: dynamic PD storage + gVisor nodes labelled by GKE.
  ["gke-sandbox"] = new {
    k8sVersion = "1.34"
    storageBackend = "dynamic"
    storageClass = "standard-rwo"
    runtimeHandler = "runsc"
    runtimeNodeSelector = new { ["sandbox.gke.io/runtime"] = "gvisor" }
  }
  // Full cloud example: S3 bucket via Mountpoint CSI + gVisor sandbox.
  ["eks-s3-gvisor"] = new {
    k8sVersion = "1.34"
    storageBackend = "s3"
    runtimeHandler = "runsc"
    runtimeNodeSelector = new { ["sandbox.gke.io/runtime"] = "gvisor" }
    awsRegion = "us-east-1"
  }
}

/// Resolve the selected profile or fail with the valid names.
function select(name: String): Profile =
  profiles.getOrNull(name) ??
    throw("unknown PROFILE '\(name)'. valid: \(profiles.keys.join(", "))")
