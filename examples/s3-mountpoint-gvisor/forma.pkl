/*
 * S3 / CSI / RuntimeClass example -- parameterized by platform profile.
 *
 * One forma, many clusters. Pick a profile with the PROFILE env var
 * (see platform.pkl); defaults to "orbstack" for a local run.
 *
 *   PROFILE=orbstack        formae apply --mode reconcile forma.pkl   # local, runs
 *   PROFILE=minikube-gvisor formae apply --mode reconcile forma.pkl   # local gVisor
 *   PROFILE=eks-s3-gvisor   formae apply --mode reconcile forma.pkl   # S3 + gVisor
 *
 * The profile decides two axes:
 *   storage  -> "dynamic" PVC (StorageClass) or "s3" bucket+CSI+static PV
 *   runtime  -> default runtime, or a sandbox RuntimeClass (e.g. gVisor runsc)
 * The Pod always mounts the storage at /data and writes a file to prove it works.
 */
amends "@formae/forma.pkl"
import "@formae/formae.pkl"

// AWS plugin (only exercised by the "s3" storage backend).
import "@aws/aws.pkl"
import "@aws/s3/bucket.pkl"

// K8s plugin (published, versioned schema).
import "@k8s/v1.34/k8s.pkl" as k8s
import "@k8s/v1.34/storage/CSIDriver.pkl" as csidriver
import "@k8s/v1.34/core/PersistentVolume.pkl" as pv
import "@k8s/v1.34/core/PersistentVolumeClaim.pkl" as pvc
import "@k8s/v1.34/node/RuntimeClass.pkl" as rc
import "@k8s/v1.34/core/Pod.pkl" as pod

import "./platform.pkl"

// --- pick the profile ---------------------------------------------------
local p = platform.select(read?("env:PROFILE") ?? "orbstack")

local useS3 = p.storageBackend == "s3"
local sandboxed = p.runtimeHandler != null

// Stable resource names (referenced across resources).
local demoBucketName = "formae-example-s3-gvisor-demo"
local pvName = "app-pv"
local pvcName = "app-pvc"
local rcName = "app-sandbox"

forma {
  new formae.Stack {
    label = "s3-csi-runtime-demo"
    description = "Storage + runtime example, profile=\(read?("env:PROFILE") ?? "orbstack")"
  }

  // K8s target always; AWS target only for the S3 backend.
  new formae.Target {
    label = "k8s-target"
    config = new k8s.Config {
      kubernetesVersion = p.k8sVersion
      auth = new k8s.KubeconfigAuth {}
    }
  }
  when (useS3) {
    new formae.Target {
      label = "aws-target"
      config = new aws.Config { region = p.awsRegion }
    }
  }

  // --- storage: S3 backend (bucket + CSIDriver + static PV) --------------
  when (useS3) {
    new bucket.Bucket {
      label = "demo-bucket"
      bucketName = demoBucketName
    }
    // Normally installed by the aws-mountpoint-s3-csi-driver add-on; shown
    // here for completeness. Delete if the add-on already owns it.
    new csidriver.CSIDriver {
      label = "s3-csi-driver"
      metadata = new k8s.ObjectMeta { name = "s3.csi.aws.com" }
      spec = new csidriver.CSIDriverSpec {
        attachRequired = false
        podInfoOnMount = false
      }
    }
    new pv.PersistentVolume {
      label = "app-pv"
      metadata = new k8s.ObjectMeta { name = pvName }
      spec = new Mapping {
        ["capacity"] = new Mapping { ["storage"] = "1200Gi" } // ignored by S3
        ["accessModes"] = new Listing { "ReadWriteMany" }
        ["mountOptions"] = new Listing { "allow-delete"; "region \(p.awsRegion)" }
        ["csi"] = new Mapping {
          ["driver"] = "s3.csi.aws.com"
          ["volumeHandle"] = "s3-csi-demo-volume"
          ["volumeAttributes"] = new Mapping { ["bucketName"] = demoBucketName }
        }
      }
    }
  }

  // --- the PVC: pins the static S3 PV, or requests a dynamic volume ------
  new pvc.PersistentVolumeClaim {
    label = "app-pvc"
    metadata = new k8s.NamespacedObjectMeta {
      name = pvcName
      namespace = "default"
    }
    spec = new pvc.PersistentVolumeClaimSpec {
      accessModes = new Listing { if (useS3) "ReadWriteMany" else "ReadWriteOnce" }
      // S3: bind the static PV, no dynamic provisioning. Dynamic: use the SC.
      storageClassName = if (useS3) "" else p.storageClass
      volumeName = if (useS3) pvName else null
      resources = new k8s.ResourceRequirements {
        requests = new Mapping {
          ["storage"] = if (useS3) 1200.gib else 100.mib
        }
      }
    }
  }

  // --- runtime: a sandbox RuntimeClass, only when the profile asks -------
  when (sandboxed) {
    new rc.RuntimeClass {
      label = "app-sandbox"
      metadata = new k8s.ObjectMeta { name = rcName }
      handler = p.runtimeHandler!!
      scheduling =
        if (p.runtimeNodeSelector != null)
          new rc.Scheduling { nodeSelector = p.runtimeNodeSelector }
        else null
    }
  }

  // --- the workload: mounts the storage, writes a file ------------------
  new pod.Pod {
    label = "app"
    metadata = new k8s.NamespacedObjectMeta {
      name = "app"
      namespace = "default"
    }
    spec = new k8s.PodSpec {
      restartPolicy = "Never"
      runtimeClassName = if (sandboxed) rcName else null
      nodeSelector = p.runtimeNodeSelector
      volumes = new Listing {
        new k8s.Volume {
          name = "data"
          persistentVolumeClaim = new k8s.PersistentVolumeClaimVolumeSource {
            claimName = pvcName
          }
        }
      }
      containers = new Listing {
        new k8s.Container {
          name = "writer"
          image = "public.ecr.aws/docker/library/busybox:1.36"
          command = new Listing {
            "sh"
            "-c"
            "echo \"hello from formae at $(date)\" > /data/demo.txt && cat /data/demo.txt && sleep 3600"
          }
          volumeMounts = new Listing {
            new k8s.VolumeMount { name = "data"; mountPath = "/data" }
          }
        }
      }
    }
  }
}
