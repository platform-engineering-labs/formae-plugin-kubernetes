/*
 * Install Flux end-to-end with formae ONLY (no kubectl) via Helm.
 *
 * The fluxcd-community/flux2 chart ships both the controllers and 14 CRDs.
 * K8S::Helm::Release hands the whole chart to the embedded Helm SDK, so Helm
 * installs the CRDs before the controllers that need them and formae manages
 * one resource: the release. A single `formae apply` installs the operator.
 *
 * Prereqs: none beyond a reachable cluster. The plugin embeds the Helm SDK, so
 * there is no `helm repo add` and no reader binary on PATH.
 *
 * Apply:
 *   pkl project resolve examples/flux
 *   formae apply --mode reconcile --yes examples/flux/flux-helm.pkl
 */
amends "@formae/forma.pkl"
import "@formae/formae.pkl"
import "@k8s/v1.33/k8s.pkl" as k8s
import "@k8s/v1.33/core/Namespace.pkl" as ns
import "@k8s/v1.33/helm/Release.pkl" as helm

forma {
  new formae.Stack {
    label = "flux"
    description = "Flux installed via Helm (controllers + 14 CRDs, one release)"
  }

  new formae.Target {
    label = "k8s-target"
    config = new k8s.Config {
      kubernetesVersion = "1.33"
      auth = new k8s.KubeconfigAuth {}
    }
  }

  local fluxNs = new ns.Namespace {
    label = "flux-system-namespace"
    metadata = new ns.NamespaceMetadata { name = "flux-system" }
  }
  fluxNs

  new helm.Release {
    label = "flux"
    metadata {
      name = "flux"
      // Resolved from the Namespace above so formae orders the two and owns
      // the namespace's lifecycle.
      namespace = fluxNs.res.name
    }

    chart = "flux2"
    repoURL = "https://fluxcd-community.github.io/helm-charts"
    version = "2.18.4"
  }
}
