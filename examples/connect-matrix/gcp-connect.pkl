/// Phase 2 of the GCP connect matrix: connect to a GKE cluster that already
/// exists, from its own stack, in its own apply.
///
///   formae apply --mode reconcile --yes examples/connect-matrix/gcp-connect.pkl
///
///   discovered cluster:
///     ... --prop cluster-stack=unmanaged --prop cluster-label=<discovered label>
amends "@formae/forma.pkl"

import "@formae/formae.pkl"
import "@gcp/container/cluster.pkl"
import "@k8s/v1.34/k8s.pkl" as k8s
import "@k8s/v1.34/core/Namespace.pkl" as ns

description {
  text = """
    Connect to an existing GKE cluster from a separate stack.

    Requires either examples/connect-matrix/gcp-cluster.pkl applied first, or
    a GKE cluster formae has discovered. Creates one probe namespace and
    nothing else.
    """
  confirm = true
}

properties {
  // Stack holding the GKE cluster. Use 'unmanaged' for a discovered cluster.
  clusterStack = new formae.Prop {
    flag = "cluster-stack"
    default = "connect-matrix-gcp-cluster"
  }
  // Resource label of the GKE cluster inside that stack.
  clusterLabel = new formae.Prop {
    flag = "cluster-label"
    default = "gke-cluster"
  }
  // Cluster minor version. Selects the K8s Pkl schema subtree.
  kubernetesVersion = new formae.Prop {
    flag = "kubernetes-version"
    default = "1.34"
  }
  // GCP project holding the cluster. Part of the plugin's token cache key.
  project = new formae.Prop {
    flag = "project"
    default = read?("env:GCP_PROJECT") ?? read?("env:GOOGLE_CLOUD_PROJECT")
      ?? throw("GCP project not set. Pass --project=<project-id> or set GCP_PROJECT / GOOGLE_CLOUD_PROJECT.")
  }
  // Zone or region the cluster lives in. Part of the token cache key.
  location = new formae.Prop {
    flag = "location"
    default = "europe-west4-a"
  }
}

// A cross-stack reference. `stack` MUST be set: forma.pkl's renderer fills a
// null stack from a resource in THIS forma, and there is no cluster here.
local clusterRef = new cluster.ClusterResolvable {
  label = properties.clusterLabel.value
  stack = properties.clusterStack.value
}

local stack: formae.Stack = new {
  label = "connect-matrix-gcp-connect"
  description = "Connect matrix (GCP): K8s target + probe, resolved across stacks."
}

// ProjectId / Location / ClusterName are what the plugin keys its token
// cache on. Without them two GKE targets are told apart by endpoint alone.
local k8sTarget: formae.Target = new {
  label = "connect-matrix-gcp-k8s"
  config = new k8s.Config {
    kubernetesVersion = properties.kubernetesVersion.value
    auth = new k8s.GKEAuth {
      endpoint = clusterRef.endpoint
      certificateAuthority = clusterRef.clusterCaCertificate
      projectId = properties.project.value
      location = properties.location.value
      clusterName = clusterRef.name
    }
  }
}

forma {
  stack
  k8sTarget

  new ns.Namespace {
    label = "connect-probe"
    metadata = new ns.NamespaceMetadata {
      name = "formae-connect-probe"
    }
  }
}
