/// Phase 1 of the GCP connect matrix: stand up a GKE cluster and NOTHING else.
///
///   formae apply --mode reconcile --yes examples/connect-matrix/gcp-cluster.pkl
///
/// Teardown (run AFTER gcp-connect.pkl has been destroyed):
///   formae destroy --on-dependents=cascade --yes examples/connect-matrix/gcp-cluster.pkl
amends "@formae/forma.pkl"

import "@formae/formae.pkl"
import "@clusters/gcp.pkl" as cluster

description {
  text = """
    GKE cluster only — no Kubernetes target.

    Pairs with examples/connect-matrix/gcp-connect.pkl, which connects to this
    cluster from a separate stack in a separate apply.
    """
  confirm = true
}

// Shared with gcp-connect.pkl. Changing it here means changing it there.
local slug = "connect-matrix"

local stack: formae.Stack = new {
  label = "connect-matrix-gcp-cluster"
  description = "Connect matrix (GCP): cluster-side resources only."
}

forma {
  stack

  // cluster.resources() is already cloud-only for GCP, minus its K8s target.
  cluster.gcpTarget(slug)
  cluster.containerAdmin(slug)
  cluster.vpc(slug)
  cluster.subnet(slug)
  cluster.gkeRouter(slug)
  cluster.nat(slug)
  cluster.gkeCluster(slug)
}
