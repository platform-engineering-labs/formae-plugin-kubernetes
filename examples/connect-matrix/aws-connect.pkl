/// Phase 2 of the AWS connect matrix: connect to an EKS cluster that already
/// exists, from its own stack, in its own apply.
///
/// The target names the cluster and nothing else. The plugin reads the
/// endpoint and CA off the EKS control plane with `eks:DescribeCluster`, so
/// there is nothing here to reference out of another stack — which is what
/// makes the same file work against a cluster formae created, a cluster
/// formae discovered, and a cluster formae has never seen.
///
///   formae apply --mode reconcile --yes examples/connect-matrix/aws-connect.pkl \
///     --prop cluster-name=<name> --prop region=<region>
///
/// Success is one namespace appearing in the cluster.
amends "@formae/forma.pkl"

import "@formae/formae.pkl"
import "@k8s/v1.34/k8s.pkl" as k8s
import "@k8s/v1.34/core/Namespace.pkl" as ns

description {
  text = """
    Connect to an existing EKS cluster from a separate stack.

    Needs eks:DescribeCluster on the cluster, and an access entry mapping the
    agent's role into Kubernetes RBAC. Creates one probe namespace and
    nothing else.
    """
  confirm = true
}

properties {
  // Name of the EKS cluster to connect to.
  clusterName = new formae.Prop {
    flag = "cluster-name"
    default = "eks-connect-matrix"
  }
  // Region the cluster lives in. Required: it is how the plugin finds the
  // cluster, and it scopes the STS token.
  region = new formae.Prop {
    flag = "region"
    default = read?("env:AWS_REGION") ?? "eu-central-1"
  }
  // Cluster minor version. Selects the K8s Pkl schema subtree.
  kubernetesVersion = new formae.Prop {
    flag = "kubernetes-version"
    default = "1.34"
  }
}

local stack: formae.Stack = new {
  label = "connect-matrix-aws-connect"
  description = "Connect matrix (AWS): K8s target + probe, connection details derived."
}

local k8sTarget: formae.Target = new {
  label = "connect-matrix-aws-k8s"
  config = new k8s.Config {
    kubernetesVersion = properties.kubernetesVersion.value
    auth = new k8s.EKSAuth {
      clusterName = properties.clusterName.value
      region = properties.region.value
    }
  }
}

forma {
  stack
  k8sTarget

  new ns.Namespace {
    label = "connect-probe"
    metadata = new ns.NamespaceMetadata {
      name = "formae-connect-probe"
    }
  }
}
