/// Phase 2 of the Azure connect matrix: connect to an AKS cluster that
/// already exists, from its own stack, in its own apply.
///
///   formae apply --mode reconcile --yes examples/connect-matrix/azure-connect.pkl
///
///   discovered cluster:
///     ... --prop cluster-stack=unmanaged --prop cluster-label=<discovered label> \
///         --prop resource-group-label=<discovered rg label>
amends "@formae/forma.pkl"

import "@formae/formae.pkl"
import "@azure/containerservice/managedcluster.pkl" as mc
import "@azure/resources/resourcegroup.pkl" as rg
import "@k8s/v1.34/k8s.pkl" as k8s
import "@k8s/v1.34/core/Namespace.pkl" as ns
import "@k8s/v1.34/core/Pod.pkl" as pod

description {
  text = """
    Connect to an existing AKS cluster from a separate stack.

    Requires either examples/connect-matrix/azure-cluster.pkl applied first,
    or an AKS cluster formae has discovered — and, either way, an AKS RBAC
    role assignment for the principal the agent runs as. Creates one probe
    namespace and nothing else.
    """
  confirm = true
}

properties {
  // Stack holding the AKS cluster. Use 'unmanaged' for a discovered cluster.
  clusterStack = new formae.Prop {
    flag = "cluster-stack"
    default = "connect-matrix-azure-cluster"
  }
  // Resource label of the AKS cluster inside that stack.
  clusterLabel = new formae.Prop {
    flag = "cluster-label"
    default = "aks-cluster"
  }
  // Resource label of the cluster's resource group inside that stack.
  resourceGroupLabel = new formae.Prop {
    flag = "resource-group-label"
    default = "aks-rg"
  }
  // Cluster minor version. Selects the K8s Pkl schema subtree.
  kubernetesVersion = new formae.Prop {
    flag = "kubernetes-version"
    default = "1.34"
  }
}

// Cross-stack references. `stack` MUST be set: forma.pkl's renderer fills a
// null stack from a resource in THIS forma, and neither of these is here.
local clusterRef = new mc.ManagedClusterResolvable {
  label = properties.clusterLabel.value
  stack = properties.clusterStack.value
}

local resourceGroupRef = new rg.ResourceGroupResolvable {
  label = properties.resourceGroupLabel.value
  stack = properties.clusterStack.value
}

local stack: formae.Stack = new {
  label = "connect-matrix-azure-connect"
  description = "Connect matrix (Azure): K8s target + probe, resolved across stacks."
}

local k8sTarget: formae.Target = new {
  label = "connect-matrix-azure-k8s"
  config = new k8s.Config {
    kubernetesVersion = properties.kubernetesVersion.value
    auth = new k8s.AKSAuth {
      // `fqdn` is a bare hostname. The plugin assigns Endpoint to
      // rest.Config.Host verbatim and client-go supplies the https scheme
      // because a CA bundle is set.
      endpoint = clusterRef.fqdn
      certificateAuthority = clusterRef.certificateAuthority
      resourceGroup = resourceGroupRef.name
      clusterName = clusterRef.name
    }
  }
}

local probeNamespace = new ns.Namespace {
  label = "connect-probe"
  metadata = new ns.NamespaceMetadata {
    name = "formae-connect-probe"
  }
}

forma {
  stack
  k8sTarget

  probeNamespace

  // The namespace proves the target authenticates. The pod proves the cluster
  // accepts work: a namespace lands even on a cluster with no schedulable
  // nodes, so on its own it says less than it looks like it does.
  new pod.Pod {
    label = "connect-probe-hello"
    metadata = new k8s.NamespacedObjectMeta {
      name = "hello-world"
      // By reference, not by name: this is the dependency edge that makes
      // formae create the namespace first. With a plain string the pod
      // races the namespace and fails with `namespaces "..." not found`.
      namespace = probeNamespace.res.name
    }
    spec = new k8s.PodSpec {
      restartPolicy = "Never"
      containers {
        new k8s.Container {
          name = "hello"
          image = "public.ecr.aws/docker/library/busybox:1.36"
          command { "sh"; "-c"; "echo hello from formae; sleep 3600" }
        }
      }
    }
  }
}
