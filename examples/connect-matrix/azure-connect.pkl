/// Phase 2 of the Azure connect matrix: connect to an AKS cluster that
/// already exists, from its own stack, in its own apply.
///
/// The target names the cluster and nothing else. Azure does not put the CA
/// on the ManagedCluster resource at all, so the plugin reads it from the
/// credentials endpoint — user credentials first, admin as a fallback — and
/// takes only the server URL and CA from that kubeconfig. The token still
/// comes from the agent's own Azure identity.
///
///   formae apply --mode reconcile --yes examples/connect-matrix/azure-connect.pkl \
///     --prop resource-group=<rg> --prop cluster-name=<name>
amends "@formae/forma.pkl"

import "@formae/formae.pkl"
import "@k8s/v1.34/k8s.pkl" as k8s
import "@k8s/v1.34/core/Namespace.pkl" as ns

description {
  text = """
    Connect to an existing AKS cluster from a separate stack.

    Needs Microsoft.ContainerService/managedClusters/listClusterUserCredential/action,
    and an AKS RBAC role assignment for the principal the agent runs as.
    Creates one probe namespace and nothing else.
    """
  confirm = true
}

properties {
  // Subscription holding the cluster. Falls back to the agent's own
  // AZURE_SUBSCRIPTION_ID when left unset.
  subscriptionId = new formae.Prop {
    flag = "subscription-id"
    default = read?("env:AZURE_SUBSCRIPTION_ID") ?? ""
  }
  // Resource group holding the cluster.
  resourceGroup = new formae.Prop {
    flag = "resource-group"
    default = "aks-connect-matrix-rg"
  }
  // Name of the AKS cluster to connect to.
  clusterName = new formae.Prop {
    flag = "cluster-name"
    default = "aks-connect-matrix"
  }
  // Cluster minor version. Selects the K8s Pkl schema subtree.
  kubernetesVersion = new formae.Prop {
    flag = "kubernetes-version"
    default = "1.34"
  }
}

local stack: formae.Stack = new {
  label = "connect-matrix-azure-connect"
  description = "Connect matrix (Azure): K8s target + probe, connection details derived."
}

local k8sTarget: formae.Target = new {
  label = "connect-matrix-azure-k8s"
  config = new k8s.Config {
    kubernetesVersion = properties.kubernetesVersion.value
    auth = new k8s.AKSAuth {
      subscriptionId = properties.subscriptionId.value
      resourceGroup = properties.resourceGroup.value
      clusterName = properties.clusterName.value
    }
  }
}

forma {
  stack
  k8sTarget

  new ns.Namespace {
    label = "connect-probe"
    metadata = new ns.NamespaceMetadata {
      name = "formae-connect-probe"
    }
  }
}
