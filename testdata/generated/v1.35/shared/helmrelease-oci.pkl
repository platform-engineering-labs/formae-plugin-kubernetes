/*
 * Conformance Test: Helm Release from an OCI registry (Create)
 *
 * The companion to helmrelease.pkl, which fetches from a classic HTTP repo. This
 * one exists because the two chart sources exercise different code and used to
 * fail differently.
 *
 * Helm's release record stores the chart's *name*, never the reference that
 * fetched it. Keeping the registry in repoURL and the name in chart is what makes
 * the field survive a round trip; a full `oci://…` reference in chart is refused
 * for exactly that reason.
 *
 * The assertion that catches a regression here is step 9 — "verifying resource
 * state unchanged after sync". With the bug, the synced state reports `podinfo`
 * while the forma says `oci://…/podinfo`, and the comparison fails.
 *
 * OCI is not an exotic case: it is how most charts are distributed now. Helm alone
 * cannot resolve a bare name against a registry — `helm pull nginx --repo oci://…`
 * fails with "invalid reference" — so the plugin joins the two itself.
 */
amends "@formae/forma.pkl"
import "@formae/formae.pkl"
import "@k8s/v1.35/core/Namespace.pkl" as ns
import "@k8s/v1.35/helm/Release.pkl" as helm
import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  local appNs = new ns.Namespace {
    label = "test-ns"
    metadata = new ns.NamespaceMetadata {
      name = "formae-test-\(v.testRunID)"
      labels = new Mapping {
        ["managed-by"] = "formae"
        ["test-run"] = v.testRunID
      }
    }
  }

  appNs

  new helm.Release {
    // No metadata.name: it defaults to this resource's label, which is the shape
    // most formae will use.
    label = "test-oci-\(v.testRunID)"
    metadata {
      namespace = appNs.res.name
    }

    // The split form: repoURL carries the registry, chart carries the name. An
    // OCI registry has no index, so the plugin joins them rather than letting
    // Helm resolve a name against a repo — `helm pull name --repo oci://…` fails.
    chart = "podinfo"
    repoURL = "oci://ghcr.io/stefanprodan/charts"
    version = "6.7.0"

    values = new Dynamic {
      replicaCount = 1
      ui {
        message = "conformance oci create"
      }
    }
  }
}
